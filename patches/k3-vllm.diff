+def _det_topk(
+    logits: torch.Tensor,
+    visible_blocks: torch.Tensor,
+    block_topk: int,
+    block_indices: torch.Tensor,
+) -> None:
+    """fase2 (VLLM_QSA_DET_TOPK_PY=1): deterministic replacement of
+    persistent_topk, whose atomic output slots and truncated candidate buffers
+    change the selected set and order run to run (vLLM #55122). Contract of
+    #55122: value descending, ties to the lowest column, indices written in
+    ascending column order; rows with visible <= k get 0..visible-1 then -1,
+    as the CUDA kernel does. Pure torch ops: no sync, CUDA-graph capturable.
+    ponytail: Python overlay (extra passes over the logits); the csrc fix of
+    #55122 is the fast path if the prefill cost matters."""
+    rows, n = logits.shape
+    k = min(block_topk, n)
+    cols = torch.arange(n, device=logits.device, dtype=torch.int32)
+    # Bound the temporaries (~16 B per logit) to about 64 MiB per pass.
+    step = max(1, (64 << 20) // (16 * max(n, 1)))
+    for start in range(0, rows, step):
+        end = min(start + step, rows)
+        vis = visible_blocks[start:end].to(torch.int32)[:, None]
+        valid = cols[None, :] < vis
+        x = torch.where(valid, logits[start:end], float("-inf"))
+        thr = torch.topk(x, k, dim=1, sorted=True).values[:, k - 1 :]
+        greater = x > thr
+        equal = x == thr
+        need = k - greater.sum(1, keepdim=True, dtype=torch.int32)
+        chosen = greater | (equal & (torch.cumsum(equal, 1, dtype=torch.int32) <= need))
+        pos = torch.where(chosen & valid, cols[None, :], n)
+        picked = torch.topk(pos, k, dim=1, largest=False, sorted=True).values
+        block_indices[start:end, :k] = torch.where(picked < vis, picked, -1)
+        if k < block_topk:
+            block_indices[start:end, k:] = -1
+
