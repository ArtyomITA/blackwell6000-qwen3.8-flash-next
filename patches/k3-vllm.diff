+    checkpoint = torch.randn(NB, HV, V, K, device="cuda") * 0.05
+    qsl = torch.tensor(qsl_list, device="cuda", dtype=torch.int32)
+    si = torch.tensor([1, 3, 5], device="cuda", dtype=torch.int32)
+
+    def run(q, k, v, out=None):
